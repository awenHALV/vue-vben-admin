# 线上研发环境
VITE_USER_NODE_ENV=devserver

VITE_GLOB_API_URL=__USE_CURRENT_ORIGIN__


# 是否开启压缩，可以设置为 none, brotli, gzip
VITE_COMPRESS=gzip

# 是否开启 PWA
VITE_PWA=false

# vue-router 的模式
# VITE_ROUTER_HISTORY=hash

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true

# 打包后是否生成dist.zip
VITE_ARCHIVER=true

# 子应用域名
VITE_APP_VPP=/vpp-web/
# VITE_APP_VPP=http://localhost:4174/vpp-web/
VITE_APP_STORE=/app-store/
VITE_APP_GRID=/grid-web/
VITE_APP_MONITOR=/monitor-web/
