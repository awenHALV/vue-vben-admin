# 本地环境
VITE_USER_NODE_ENV=development

# 端口号
VITE_PORT=5999

# 接口地址
VITE_GLOB_API_URL=/api

# 是否开启 Nitro Mock服务，true 为开启，false 为关闭
VITE_NITRO_MOCK=true

# 是否打开 devtools，true 为打开，false 为关闭
VITE_DEVTOOLS=true

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true

# 前端代理 proxy 目标地址
VITE_DEV_PROXY_TARGET=http://100.153.1.117:30100

# 前端代理能源 proxy 目标地址
VITE_DEV_PROXY_TARGET_ENERGY=http://100.153.1.74:30123

# 天气接口 proxy地址
VITE_DEV_PROXY_WEATHER=http://100.153.2.125:30052

# AI小助手 proxy 目标地址
 VITE_DEV_PROXY_TARGET_AI_ASSISTANT=http://192.168.0.76:8001
#VITE_DEV_PROXY_TARGET_AI_ASSISTANT=http://100.153.1.74.30110

# 子应用域名
#能源平台
VITE_APP_VPP=http://localhost:6001/vpp-web/
#应用市场
VITE_APP_STORE=http://localhost:6003/app-store/
#微网
VITE_APP_GRID=http://localhost:6006/grid-web/
#监控中心
VITE_APP_MONITOR=http://localhost:6007/monitor-web/
#测试
VITE_APP_ZZ=http://localhost:4001/
VITE_APP_GRID=http://localhost:6006/grid-web/
