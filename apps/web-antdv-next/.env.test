# 测试环境
VITE_USER_NODE_ENV=test
# 接口根路径
VITE_GLOB_API_URL=/api

# 接口地址：__USE_CURRENT_ORIGIN__ 在运行时解析为「当前页面 origin + /api」（测试/线上同一构建）
# 若后端路径不是 /api，可写 __USE_CURRENT_ORIGIN__/your-prefix
VITE_GLOB_API_URL=__USE_CURRENT_ORIGIN__
# 是否开启压缩，可以设置为 none, brotli, gzip
VITE_COMPRESS=gzip

# 是否开启 PWA
VITE_PWA=false

# vue-router 的模式
# VITE_ROUTER_HISTORY=hash

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true

# 打包后是否生成dist.zip
VITE_ARCHIVER=true

# 子应用域名
VITE_APP_VPP=/vpp-web/

