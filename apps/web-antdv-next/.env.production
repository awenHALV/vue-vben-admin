VITE_BASE=/

# 接口地址
VITE_GLOB_API_URL=http://100.153.1.117:30100/api
# 是否开启压缩，可以设置为 none, brotli, gzip
VITE_COMPRESS=none

# 是否开启 PWA
VITE_PWA=false

# vue-router 的模式
VITE_ROUTER_HISTORY=hash

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true

# 打包后是否生成dist.zip
VITE_ARCHIVER=true

# 子应用域名
VITE_APP_VPP=http://100.153.1.117:30120/
VITE_APP_ZZ=http://localhost:4001/
